{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpotiTube",
  "version": "1.6.2",
  "identifier": "app.spotitube.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SpotiTube",
        "width": 1280,
        "height": 820,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "center": true,
        "dragDropEnabled": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "SpotiTube",
    "category": "Music",
    "shortDescription": "Lightweight YouTube Music desktop player",
    "longDescription": "SpotiTube is a lightweight, native YouTube Music client with a Spotify-style and a Frutiger Aero theme.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}